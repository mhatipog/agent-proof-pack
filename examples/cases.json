[
  {
    "id": "01-valid-invoice",
    "description": "Valid invoice and authorized action passes every invariant",
    "expected": "approve",
    "policy": {
      "id": "synthetic/01-valid-invoice",
      "rules": [
        {
          "id": "sum-precisely",
          "kind": "decimal_total",
          "lines": "proposed.lines",
          "tax": "proposed.vat",
          "total": "proposed.total"
        },
        {
          "id": "customer-present",
          "kind": "exists_in",
          "value": "proposed.customer_id",
          "collection": "authority.customer_ids"
        },
        {
          "id": "amount-cap",
          "kind": "max_amount",
          "value": "proposed.total",
          "limit": "authority.max_amount"
        },
        {
          "id": "allowed-tool-resource",
          "kind": "tool_permission",
          "tool": "action.tool",
          "resource": "action.resource",
          "allowed_tools": "grants.tools",
          "allowed_resources": "grants.resources"
        },
        {
          "id": "not-a-replay",
          "kind": "unique_action",
          "action_id": "action.id",
          "processed_ids": "before.processed_action_ids"
        }
      ]
    },
    "evidence": {
      "phase": "preflight",
      "action": {
        "id": "invoice-2026-001",
        "tool": "invoice.create",
        "resource": "acct:demo"
      },
      "before": {
        "processed_action_ids": []
      },
      "proposed": {
        "customer_id": "C-042",
        "lines": [
          {
            "quantity": "2",
            "unit_price": "3000.00"
          },
          {
            "quantity": "1",
            "unit_price": "2100.00"
          }
        ],
        "vat": "321.37",
        "total": "8421.37",
        "currency": "EUR",
        "bank_account": "BE00-DEMO"
      },
      "authority": {
        "customer_ids": [
          "C-042",
          "C-901"
        ],
        "max_amount": "10000.00"
      },
      "grants": {
        "tools": [
          "invoice.create"
        ],
        "resources": [
          "acct:demo"
        ]
      }
    }
  },
